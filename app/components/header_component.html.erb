<%= govuk_header(
  homepage_url: "https://www.gov.uk",
  classes: %w[govuk-header--full-width-border app-header--wide-logo with-extra-content],
) do |header| %>

  <% if account_options? %>
    <div class="govuk-header__content account-options">
      <%= account_options %>
    </div>
  <% elsif current_user.present? %>
    <div class="govuk-header__content account-options">
      <%= govuk_link_to(Settings.dfe_signin.profile, inverse: true, no_underline: true) { current_user.full_name } %>
      <%= govuk_link_to(sign_out_path, inverse: true, no_underline: true) { "Sign out" } %>
    </div>
  <% end %>

  <% header.with_service_navigation(service_name:, service_url:, current_path: request.path, navigation_id: "service-navigation") do |service_navigation| %>
    <% navigation_items.each do |navigation_item| %>
      <%= service_navigation.with_navigation_item text: navigation_item.text, href: navigation_item.href, active_when: navigation_item.active_when %>
    <% end %>
  <% end %>

  <% if phase_banner_text? %>
    <% header.with_phase_banner(tag: phase_banner_tag, classes: %w[govuk-width-container govuk-!-display-none-print]) do %>
      <%== phase_banner_text %>
    <% end %>
  <% else %>
    <% header.with_phase_banner(tag: phase_banner_tag, text: nil, classes: %w[govuk-width-container govuk-!-display-none-print]) %>
  <% end %>
<% end %>
