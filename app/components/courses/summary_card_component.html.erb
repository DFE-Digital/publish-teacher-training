<li class="app-search-results__item">
  <%= govuk_summary_card(classes: %w[course-summary-card], title:) do |card| %>
    <%= card.with_summary_list(actions: false, classes: ["govuk-summary-list--no-border"]) do |summary_list| %>
      <% summary_list.with_row do |row| %>
        <% row.with_value do %>
          <strong>
            <%= govuk_link_to course.name_and_code,
              find_course_path(
                provider_code: course.provider_code,
                course_code: course.course_code,
                location: @location
              ) %>
          </strong>
        <% end %>
      <% end %>
      <% summary_list.with_row do |row| %>
        <% row.with_value do %>
          <div class="govuk-body">
            <!-- location -->
            <% if search_by_location? %>
              <div class="govuk-!-margin-bottom-0">
                <%= nearest_placement_school_text %>
              </div>
            <% end %>
            <!-- end location -->
            <div>
              <%= fees_display %>
              <p class="govuk-!-margin-bottom-5">
                <%= qualification_value.html_safe %>,
                <%= study_mode_value %>
                <% if show_start_date? %>
                  <br>
                  <%= course.start_date.to_fs(:month_and_year) %>
                <% end %>
              </p>
              <div>
                <% if save_toggle_button.present? %>
                  <%= save_toggle_button %>
                <% end %>
              </div>
              <% if course.salary? || course.apprenticeship? %>
                <div class="school-experience-requirements-box govuk-!-margin-top-3">
                  <span class="govuk-body">School experience is required or strongly recommended</span>
                </div>
              <% end%>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </li>
