<li class="app-search-results__item">
  <%= govuk_summary_card(classes: %w[course-summary-card], title:) do |card| %>
    <%= card.with_summary_list(actions: false, classes: ["govuk-summary-list--no-border"]) do |summary_list| %>
      <% summary_list.with_row do |row| %>
        <% row.with_value do %>
          <strong>
            <%= govuk_link_to course.name_and_code,
            find_course_path(
              provider_code: course.provider_code,
              course_code: course.course_code,
              location: @location
            ) %>
          </strong>
        <% end %>
      <% end %>
      <% summary_list.with_row do |row| %>
        <% row.with_value do %>
          <div class="govuk-!-font-size-16">
            <%= funding_value %>, <%= study_mode_value %>, <%= qualification_value.html_safe %>
          </div>
          <div class="govuk-hint govuk-!-font-size-16">
            <%= incentive_hint %>
          </div>
        <% end %>
      <% end %>
      <% if show_start_date? %>
        <% summary_list.with_row do |row| %>
          <% row.with_value(text: course.start_date.to_fs(:month_and_year)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</li>
