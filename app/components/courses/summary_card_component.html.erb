<li class="app-search-results__item">
  <%= govuk_summary_card(classes: %w[course-summary-card], title:) do |card| %>

    <%= card.with_summary_list(actions: false, classes: ["govuk-summary-list--no-border"]) do |summary_list| %>

      <% summary_list.with_row do |row| %>
        <% row.with_value do %>
          <strong>
            <%= govuk_link_to course.name_and_code,
              find_course_path(
                provider_code: course.provider_code,
                course_code: course.course_code,
                location: @location
              ) %>
          </strong>
        <% end %>
      <% end %>

      <% summary_list.with_row do |row| %>
        <% row.with_value do %>
          <div class="govuk-body">
            <%= funding_value %>

            <% if incentive_hint.present? %>
              <br>
              <span class="govuk-hint govuk-!-font-size-16">
                <%= incentive_hint %>
              </span>
            <% end %>

            <br>
            <%= qualification_value.html_safe %>

            <br>
            <%= study_mode_value %>

            <% if show_start_date? %>
              <br>
              <%= course.start_date.to_fs(:month_and_year) %>
            <% end %>
            <br><br>
             <% if save_toggle_button.present? %>
              <%= save_toggle_button %>
            <% end %>
          </div>
        <% end %>
      <% end %>

    <% end %>

  <% end %>
</li>
