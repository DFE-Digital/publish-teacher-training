<%= govuk_header(
  homepage_url: "https://www.gov.uk",
  classes: %w[govuk-header--full-width-border app-header--wide-logo with-extra-content],
) do |header| %>

  <% if current_user.present? %>
    <div class="govuk-header__content account-options">
      <% if current_user.admin? %>
        <%= govuk_link_to(support_root_path, inverse: true, no_underline: true) { "Support console" } %>
        <%= govuk_link_to(sign_out_path, inverse: true, no_underline: true) { "Sign out" } %>
      <% else %>
        <% if current_user.associated_with_accredited_provider? %>
          <%= govuk_link_to(publish_notifications_path, inverse: true, no_underline: true) { "Notifications" } %>
        <% end %>
        <%= govuk_link_to(sign_out_path, inverse: true, no_underline: true) { "Sign out" } %>
        <%= govuk_link_to(Settings.dfe_signin.profile, inverse: true, no_underline: true) { "(#{current_user.first_name} #{current_user.last_name})" } %>
      <% end %>
    </div>
  <% end %>

  <% header.with_service_navigation(service_name:, service_url: publish_root_path, current_path: request.path, navigation_id: "service-navigation") do |service_navigation| %>
    <% if show_navigation? %>
      <% navigation_items.each do |item| %>
        <%= service_navigation.with_navigation_item text: item[:name], href: item[:url], active_when: active_when_for(item) %>
      <% end %>
    <% end %>
  <% end %>

  <% header.with_phase_banner(
    tag: { text: environment_label, colour: environment_colour },
    text: phase_banner_text,
    classes: %w[govuk-width-container govuk-!-display-none-print],
  ) %>
<% end %>
