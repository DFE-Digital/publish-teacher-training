<% content_for :page_title, t(".page_title") %>

<h1 class="govuk-heading-l"><%= t(".page_title") %></h1>

<%= govuk_button_link_to t(".add_banner"), new_support_banner_path %>

<%= render TabNavigation.new(items: [
  { name: t(".statuses.scheduled"), url: scheduled_support_banners_path },
  { name: t(".statuses.active"), url: active_support_banners_path },
  { name: t(".statuses.expired"), url: expired_support_banners_path },
]) %>

<%= govuk_table do |table| %>
  <% table.with_head do |head| %>
    <% head.with_row do |row| %>
      <% row.with_cell text: Banner.human_attribute_name(:name) %>
      <% row.with_cell text: t(".columns.#{@scope_status}.published_at") %>
      <% row.with_cell text: t(".columns.#{@scope_status}.expired_at") %>
      <% row.with_cell text: Banner.human_attribute_name(:displayed_on) %>
      <% row.with_cell text: t(".table.headings.preview") %>
      <% if @scope_status == :scheduled %>
        <% row.with_cell text: t(".table.headings.actions"), classes: "app-table--banners__actions" %>
      <% end %>
    <% end %>
  <% end %>

  <% table.with_body do |body| %>
    <% @banners.each do |banner| %>
      <% body.with_row do |row| %>
        <% row.with_cell text: govuk_link_to(banner.name, banner.editable? ? edit_support_banner_path(banner) : support_banner_path(banner)) %>
        <% row.with_cell text: banner.published_at.to_fs(:govuk_date_and_time) %>
        <% row.with_cell text: banner.expired_at.present? ? banner.expired_at.to_fs(:govuk_date_and_time) : t(".missing_expired_at") %>
        <% row.with_cell text: displayed_on_text(banner) %>
        <% row.with_cell do %>
          <%= govuk_link_to(t(".table.actions.preview"), support_banner_path(banner)) %>
        <% end %>
        <% if @scope_status == :scheduled %>
          <% row.with_cell(classes: "app-table--banners__actions") do %>
            <%= govuk_button_link_to(
                  t(".table.actions.delete"),
                  delete_support_banner_path(banner),
                  class: "govuk-button--warning govuk-!-margin-bottom-0",
                ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= govuk_pagination(pagy: @pagy) %>
