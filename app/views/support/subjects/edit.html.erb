<% content_for :before_content do %>
  <%= govuk_back_link_to(support_subject_path(@subject)) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">

    <%= form_with model: @subject,
                  url: support_subject_path(@subject),
                  scope: :subject,
                  local: true do |f| %>

    <%= f.govuk_text_area :match_synonyms_text,
        label: {
          text: t(
            "support.subjects.update_subject_synonyms",
            subject_name: @subject.subject_name
          ),
          size: "l",
          tag: "h1"
        },
        hint: {
          text: t("support.subjects.match_synonyms_hint_html").html_safe
        },
        rows: 4,
        value: @subject.match_synonyms_text %>

      <%= f.govuk_submit t(
            "support.subjects.update_subject_synonyms",
            subject_name: @subject.subject_name
          ) %>

      <p class="govuk-body">
        <%= govuk_link_to(t("cancel"), support_subject_path(@subject)) %>
      </p>

    <% end %>
  </div>
</div>
