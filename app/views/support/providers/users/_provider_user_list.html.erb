<table class="govuk-table">
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th scope="col" class="govuk-table__header"><%= t(".name") %></th>
      <th scope="col" class="govuk-table__header"><%= t(".email") %></th>
      <th scope="col" class="govuk-table__header"><%= t(".last_signed_in") %></th>
      <th scope="col" class="govuk-table__header"><%= t(".remove_user") %></th>
    </tr>
  </thead>

  <tbody class="govuk-table__body">
    <% @users.each do |user| %>
      <tr class="govuk-table__row user-row">
        <td class="govuk-table__cell">
          <span class="govuk-!-display-block govuk-!-margin-bottom-1">
              <%= govuk_link_to(user.full_name, support_recruitment_cycle_provider_user_path(@provider.recruitment_cycle_year, @provider, user), class: "govuk-heading-s govuk-!-margin-bottom-0") %>
          </span>
        </td>

        <td class="govuk-table__cell">
          <span class="govuk-!-display-block govuk-!-margin-bottom-1">
            <%= user.email %>
          </span>
        </td>

        <td class="govuk-table__cell">
          <%= user.last_login_date_utc&.to_fs(:month_and_year) || t(".never_signed_in") %>
        </td>

        <td class="govuk-table__cell">
          <%= govuk_link_to(delete_support_recruitment_cycle_provider_user_path(@provider.recruitment_cycle_year, @provider, user), class: "app-link--destructive") do %>
            <%= t(".remove_user") %>
            <%= tag.span(t(".remove_user_for", name: user.full_name), class: "govuk-visually-hidden") %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
