<%= render PageTitle.new(title: "support.providers.show") %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_providers_path,
  ) %>
<% end %>

<div class="govuk-caption-l"><%= Provider.human_attribute_name(@provider.provider_type) %></div>
<h1 class="govuk-heading-l">
  <%= govuk_link_to @provider.name_and_code, publish_provider_path(@provider.provider_code), no_visited_state: true %>
</h1>

<%= render "support/providers/navigation" %>

<%= govuk_button_link_to(
  t("support.providers.users.add_user_in_publish"),
  new_publish_provider_user_path(
    provider_code: @provider.provider_code,
    return_to: "support",
    recruitment_cycle_year: @provider.recruitment_cycle_year,
  ),
) %>
<%= render Users::SortLinksComponent.new(
  sort: @sort,
  name_path: support_recruitment_cycle_provider_users_path(@provider.recruitment_cycle_year, @provider),
  last_signed_in_path: support_recruitment_cycle_provider_users_path(@provider.recruitment_cycle_year, @provider, sort: "last_signed_in"),
) %>
<%= render "provider_user_list", users: @users, provider: @provider %>
<%= govuk_pagination(pagy: @pagy) %>
