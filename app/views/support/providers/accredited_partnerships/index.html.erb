<%= render PageTitle.new(title: t(".title")) %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_providers_path,
  ) %>
<% end %>

<div class="govuk-caption-l"><%= Provider.human_attribute_name(@provider.provider_type) %></div>
<h1 class="govuk-heading-l">
  <%= govuk_link_to @provider.name_and_code, publish_provider_path(@provider.provider_code), no_visited_state: true %>
</h1>

<%= render "support/providers/navigation" %>

<%= govuk_button_link_to(
  t(".add"),
  search_publish_provider_recruitment_cycle_accredited_providers_path(
    @provider.provider_code,
    @provider.recruitment_cycle_year,
    return_to: "support",
  ),
) %>

<% if @partnerships.none? %>
  <p class="govuk-body"><%= t(".no_providers", provider_name: @provider.provider_name) %>.</p>
<% else %>
  <table class="govuk-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header"><%= t(".name") %></th>
        <th scope="col" class="govuk-table__header govuk-!-text-align-right"><%= t(".view_in_publish") %></th>
      </tr>
    </thead>

    <tbody class="govuk-table__body">
      <% @partnerships.each do |partnership| %>
        <% accredited_provider = partnership.accredited_provider %>
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">
            <%= govuk_link_to(
              accredited_provider.name_and_code,
              support_recruitment_cycle_provider_path(accredited_provider.recruitment_cycle_year, accredited_provider),
            ) %>
          </td>
          <td class="govuk-table__cell govuk-!-text-align-right">
            <%= govuk_link_to(
              safe_join([
                t(".view_accredited_provider"),
                content_tag(:span, accredited_provider.name_and_code, class: "govuk-visually-hidden"),
              ], " "),
              publish_provider_recruitment_cycle_accredited_partnership_path(
                @provider.provider_code,
                @provider.recruitment_cycle_year,
                accredited_provider.provider_code,
                return_to: "support",
              ),
            ) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
