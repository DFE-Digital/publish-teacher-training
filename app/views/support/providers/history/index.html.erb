<%= render PageTitle.new(title: "support.providers.history.index") %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_providers_path,
  ) %>
<% end %>

<div class="govuk-caption-l"><%= Provider.human_attribute_name(@provider.provider_type) %></div>
<h1 class="govuk-heading-l">
  <%= govuk_link_to @provider.name_and_code, publish_provider_path(@provider.provider_code), no_visited_state: true %>
</h1>

<%= render "support/providers/navigation" %>

<% if @history_entries.any? %>
  <%= govuk_table do |table| %>
    <% table.with_head do |head| %>
      <% head.with_row do |row| %>
        <% row.with_cell text: t(".change") %>
        <% row.with_cell text: t(".time") %>
        <% row.with_cell text: t(".user") %>
      <% end %>
    <% end %>

    <% table.with_body do |body| %>
      <% @history_entries.each do |entry| %>
        <% body.with_row do |row| %>
          <% row.with_cell do %>
            <%= render "support/providers/history/change", entry: entry, provider: @provider %>
          <% end %>
          <% row.with_cell text: entry.formatted_time %>
          <% row.with_cell do %>
            <%= entry.user_name %>
            <% if entry.admin? %>
              <%= govuk_tag(text: t(".admin"), colour: "grey", classes: "govuk-!-margin-left-1") %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <p class="govuk-body"><%= t(".no_changes") %></p>
<% end %>
