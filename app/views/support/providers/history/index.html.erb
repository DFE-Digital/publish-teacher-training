<%= render PageTitle.new(title: "support.providers.history.index") %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_providers_path,
  ) %>
<% end %>

<div class="govuk-caption-l"><%= Provider.human_attribute_name(@provider.provider_type) %></div>
<h1 class="govuk-heading-l">
  <%= govuk_link_to @provider.name_and_code, publish_provider_path(@provider.provider_code), no_visited_state: true %>
</h1>

<%= render "support/providers/navigation" %>

<% if @history_entries.any? %>
  <table class="govuk-table">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header"><%= t(".change") %></th>
        <th scope="col" class="govuk-table__header app-table--history__time"><%= t(".time") %></th>
        <th scope="col" class="govuk-table__header app-table--history__user"><%= t(".user") %></th>
      </tr>
    </thead>

    <tbody class="govuk-table__body">
      <% @history_entries.each do |entry| %>
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">
            <%= render "support/providers/history/change", entry: entry, provider: @provider %>
          </td>
          <td class="govuk-table__cell app-table--history__time">
            <%= entry.formatted_time %>
          </td>
          <td class="govuk-table__cell app-table--history__user">
            <%= entry.user_name %>
            <% if entry.admin? %>
              <%= govuk_tag(text: t(".admin"), colour: "grey", classes: "govuk-!-margin-left-1") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= govuk_pagination(pagy: @pagy) %>
<% else %>
  <p class="govuk-body"><%= t(".no_changes") %></p>
<% end %>
