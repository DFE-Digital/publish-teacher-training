<%= render PageTitle.new(title: "support.providers.onboarding.contacts.new", has_errors: current_step.errors.any?) %>

<h1 class="govuk-heading-l">
  <span class="govuk-caption-l">Add organisation</span>
  Contact details
</h1>

<%= form.govuk_text_field :email, label: { text: "Email address", size: "s" }, width: "two-thirds" %>
<%= form.govuk_text_field :telephone, label: { text: "Telephone number", size: "s" }, width: "two-thirds" %>
<%= form.govuk_text_field :website, label: { text: "Website", size: "s" }, width: "two-thirds" %>

<%= form.govuk_fieldset legend: { text: "Address", size: "m" } do %>
  <%= form.govuk_text_field :address1, label: { text: "Address line 1", size: "s" } %>
  <%= form.govuk_text_field :address2, label: { text: "Address line 2 (optional)", size: "s" } %>
  <%= form.govuk_text_field :address3, label: { text: "Address line 3 (optional)", size: "s" } %>
  <%= form.govuk_text_field :town, label: { text: "Town or city", size: "s" }, width: "two-thirds" %>
  <%= form.govuk_text_field :address4, label: { text: "County (optional)", size: "s" }, width: "two-thirds" %>
  <%= form.govuk_text_field :postcode, label: { text: "Postcode", size: "s" }, width: 10 %>
<% end %>

<%= form.govuk_submit %>
