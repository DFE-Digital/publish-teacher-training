<%= render PageTitle.new(title: "support.providers.onboarding.checks.show", has_errors: current_step.errors.any?) %>

<% provider = wizard.step(:provider_details) %>
<% contact = wizard.step(:contact_details) %>
<% provider_change_path = wizard.change_path(:provider_details) %>
<% contact_change_path = wizard.change_path(:contact_details) %>

<h1 class="govuk-heading-l">
  <span class="govuk-caption-l">Add organisation</span>
  Check your answers
</h1>

<%= render GovukComponent::SummaryListComponent.new do |component|
      component.with_row do |row|
        row.with_key { "Provider name" }
        row.with_value { provider.provider_name }
        row.with_action(text: "Change", href: provider_change_path, visually_hidden_text: "provider name")
      end

      component.with_row do |row|
        row.with_key { "Provider code" }
        row.with_value { provider.provider_code }
        row.with_action(text: "Change", href: provider_change_path, visually_hidden_text: "provider code")
      end

      component.with_row do |row|
        row.with_key { "UK provider reference number (UKPRN)" }
        row.with_value { provider.ukprn }
        row.with_action(text: "Change", href: provider_change_path, visually_hidden_text: "UKPRN")
      end

      component.with_row do |row|
        row.with_key { "Is the organisation an accredited provider?" }
        row.with_value { provider.accredited? ? "Yes" : "No" }
        row.with_action(text: "Change", href: provider_change_path, visually_hidden_text: "accredited provider")
      end

      if provider.accredited?
        component.with_row do |row|
          row.with_key { "Accredited provider number" }
          row.with_value { provider.accredited_provider_number }
          row.with_action(text: "Change", href: provider_change_path, visually_hidden_text: "accredited provider number")
        end
      end

      component.with_row do |row|
        row.with_key { "Provider type" }
        row.with_value { t("support.providers.provider_type.#{provider.provider_type}") }
        row.with_action(text: "Change", href: provider_change_path, visually_hidden_text: "provider type")
      end

      if provider.lead_school?
        component.with_row do |row|
          row.with_key { "Unique reference number (URN)" }
          row.with_value { provider.urn }
          row.with_action(text: "Change", href: provider_change_path, visually_hidden_text: "URN")
        end
      end
    end %>

<h2 class="govuk-heading-m">Contact details</h2>

<%= render GovukComponent::SummaryListComponent.new do |component|
      component.with_row do |row|
        row.with_key { "Email address" }
        row.with_value { contact.email }
        row.with_action(text: "Change", href: contact_change_path, visually_hidden_text: "email address")
      end

      component.with_row do |row|
        row.with_key { "Telephone number" }
        row.with_value { contact.telephone }
        row.with_action(text: "Change", href: contact_change_path, visually_hidden_text: "telephone number")
      end

      component.with_row do |row|
        row.with_key { "Website" }
        row.with_value { contact.website }
        row.with_action(text: "Change", href: contact_change_path, visually_hidden_text: "website")
      end

      component.with_row do |row|
        row.with_key { "Address" }
        row.with_value { contact.full_address }
        row.with_action(text: "Change", href: contact_change_path, visually_hidden_text: "address")
      end
    end %>

<%= form.govuk_submit(t("support.providers.add")) %>
