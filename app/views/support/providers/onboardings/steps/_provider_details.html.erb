<%= render PageTitle.new(title: "support.providers.onboardings.new", has_errors: current_step.errors.any?) %>

<h1 class="govuk-heading-l">
  <span class="govuk-caption-l">Add organisation</span>
  Organisation details
</h1>

<%= form.govuk_text_field :provider_name, label: { text: "Provider name", size: "s" } %>
<%= form.govuk_text_field :provider_code, label: { text: "Provider code", size: "s" }, width: 10 %>

<%= form.govuk_text_field :ukprn, form_group: { class: "govuk-!-margin-bottom-2" }, label: { text: "UK provider reference number (UKPRN)", size: "s" }, width: 10 %>
<p class="govuk-body govuk-!-margin-bottom-5">
  <%= t("links.ukprn_html") %>
</p>

<%= form.govuk_radio_buttons_fieldset(:accredited, legend: { text: "Is the organisation an accredited provider?", size: "s" }) do %>
  <%= form.govuk_radio_button :accredited, "1", label: { text: "Yes" }, link_errors: true do %>
    <%= form.govuk_text_field :accredited_provider_number,
                              width: 10,
                              label: { text: "Accredited provider number" },
                              autocomplete: :disabled %>
  <% end %>
  <%= form.govuk_radio_button :accredited, "0", label: { text: "No" }, link_errors: true %>
<% end %>

<%= form.govuk_radio_buttons_fieldset(:provider_type, legend: { text: "Provider type", size: "s" }) do %>
  <%= form.govuk_radio_button :provider_type, :university, label: { text: "Higher education institution (HEI)" }, link_errors: true %>
  <%= form.govuk_radio_button :provider_type, :scitt, label: { text: "School centred initial teacher training (SCITT)" }, link_errors: true %>
  <%= form.govuk_radio_button :provider_type, :lead_school, label: { text: "School" }, link_errors: true do %>
    <%= form.govuk_text_field :urn,
                              width: 10,
                              label: { text: "Unique reference number (URN)" },
                              autocomplete: :disabled %>
    <p class="govuk-body govuk-!-margin-top-2">
      <%= t("links.urn_html") %>
    </p>
  <% end %>
<% end %>

<%= form.govuk_submit %>
