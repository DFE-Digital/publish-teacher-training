<%= render PageTitle.new(title: "support.providers.courses.index") %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_providers_path,
  ) %>
<% end %>

<div class="govuk-caption-l"><%= Provider.human_attribute_name(@provider.provider_type) %></div>
<h1 class="govuk-heading-l">
  <%= govuk_link_to @provider.name_and_code, publish_provider_path(@provider.provider_code), no_visited_state: true %>
</h1>

<%= render "support/providers/navigation" %>

<%= govuk_link_to "Copy Courses", new_support_recruitment_cycle_provider_copy_course_path(@recruitment_cycle.year, @provider), class: "govuk-button" %>

<p class="govuk-body-s"><%= t(".course_count", count: @course_count) %></p>

<%= govuk_table do |table| %>
  <% table.with_head do |head| %>
    <% head.with_row do |row| %>
      <% row.with_cell text: t(".course") %>
      <% if @show_accredited_provider %>
        <% row.with_cell text: t(".accredited_provider"), width: "one-quarter" %>
      <% end %>
      <% if @course_information_fields.any? %>
        <% row.with_cell text: t(".course_information") %>
      <% end %>
      <% row.with_cell text: t(".status") %>
      <% row.with_cell %>
    <% end %>
  <% end %>

  <% table.with_body do |body| %>
    <% @courses.each do |course| %>
      <% decorated = course.decorate %>
      <% body.with_row classes: %w[course-row] do |row| %>
        <% row.with_cell classes: %w[name] do %>
          <%= govuk_link_to(
                course.name_and_code,
                publish_provider_recruitment_cycle_course_url(@provider.provider_code, @provider.recruitment_cycle_year, course.course_code),
                class: "govuk-!-font-weight-bold",
              ) %>
          <% if course.primary_course? && course.age_range_in_years.present? %>
            <div class="govuk-hint govuk-!-margin-bottom-0">
              <%= t("publish.courses.course_table.primary_age_range", age_range: decorated.age_range) %>
            </div>
          <% end %>
        <% end %>

        <% if @show_accredited_provider %>
          <% row.with_cell do %>
            <% if course.accrediting_provider %>
              <%= govuk_link_to(course.accrediting_provider.provider_name, support_recruitment_cycle_provider_path(@provider.recruitment_cycle_year, course.accrediting_provider)) %>
            <% end %>
          <% end %>
        <% end %>

        <% if @course_information_fields.any? %>
          <% row.with_cell classes: %w[course-information] do %>
            <%= render Courses::InformationLinesComponent.new(course:, fields: @course_information_fields) %>
          <% end %>
        <% end %>

        <% row.with_cell text: decorated.status_tag, classes: %w[status] %>

        <% row.with_cell text: govuk_link_to("Change", edit_support_recruitment_cycle_provider_course_url(@provider.recruitment_cycle_year, @provider, course)), classes: %w[change] %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<%= govuk_pagination(pagy: @pagy) %>

<% if @courses.any? %>
  <div class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-full">
      <div class="app-status-box">
        <h2 class="govuk-heading-m"><%= t(".downloads.heading") %></h2>
        <p class="govuk-body">
          <%= govuk_link_to(
            t(".downloads.course_information"),
            download_course_information_publish_provider_recruitment_cycle_courses_path(
              @provider.provider_code,
              @provider.recruitment_cycle_year,
              format: :csv,
            ),
          ) %>
        </p>
        <p class="govuk-body">
          <%= govuk_link_to(
            t(".downloads.schools"),
            download_course_schools_publish_provider_recruitment_cycle_courses_path(
              @provider.provider_code,
              @provider.recruitment_cycle_year,
              format: :csv,
            ),
          ) %>
        </p>
        <p class="govuk-body">
          <%= govuk_link_to(
            t(".downloads.full_course_information"),
            download_full_course_information_support_recruitment_cycle_provider_courses_path(
              @provider.recruitment_cycle_year,
              @provider,
              format: :csv,
            ),
          ) %>
        </p>
      </div>
    </div>
  </div>
<% end %>
