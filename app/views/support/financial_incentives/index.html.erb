<% content_for :page_title, t(".page_title") %>

<% content_for :before_content do %>
  <%= govuk_back_link_to(support_settings_path) %>
<% end %>

<h1 class="govuk-heading-l"><%= t(".page_title") %></h1>

<p class="govuk-body"><%= t(".intro") %></p>

<ul class="govuk-list govuk-list--spaced">
  <% @years.each do |year| %>
    <li>
      <%= govuk_link_to(
            financial_incentive_year_label(year),
            year_support_financial_incentives_path(year),
          ) %>
      <% if financial_incentive_year_published?(year) %>
        <%= govuk_tag(text: t(".published_tag"), colour: "green") %>
      <% end %>
    </li>
  <% end %>
</ul>

<% if @create_year.present? %>
  <%= govuk_button_to(
        t(".create", year_range: Find::CycleTimetable.cycle_year_range(@create_year)),
        create_year_support_financial_incentives_path(year: @create_year),
        method: :post,
      ) %>
<% end %>
