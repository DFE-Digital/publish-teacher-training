<% content_for :page_title, t(".page_title") %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= govuk_panel(title_text: t(".page_title")) %>

    <%= govuk_warning_text(text: t(".warning")) %>

    <%= govuk_summary_list do |summary_list| %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: APIKey.human_attribute_name(:name)) %>
        <% row.with_value(text: @api_key.name) %>
      <% end %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: APIKey.human_attribute_name(:email)) %>
        <% row.with_value(text: @api_key.email) %>
      <% end %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: t(".key")) %>
        <% row.with_value(text: tag.code(@api_key.secret)) %>
      <% end %>
    <% end %>

    <p class="govuk-body">
      <%= govuk_link_to t(".back"), support_api_keys_path %>
    </p>
  </div>
</div>
