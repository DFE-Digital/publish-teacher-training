<% content_for :page_title, t(".page_title") %>

<%= content_for(:before_content) do %>
  <%= govuk_back_link(href: support_api_keys_path) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <span class="govuk-caption-l"><%= t(".page_caption") %></span>
    <h1 class="govuk-heading-l"><%= t(".page_title") %></h1>

    <%= govuk_summary_list do |summary_list| %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: APIKey.human_attribute_name(:name)) %>
        <% row.with_value(text: @api_key.name) %>
      <% end %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: APIKey.human_attribute_name(:email)) %>
        <% row.with_value(text: @api_key.email) %>
      <% end %>
      <% summary_list.with_row do |row| %>
        <% row.with_key(text: APIKey.human_attribute_name(:prefix)) %>
        <% row.with_value(text: tag.code(@api_key.prefix)) %>
      <% end %>
    <% end %>

    <%= govuk_warning_text(text: t(".explanation")) %>

    <div class="govuk-button-group">
      <%= govuk_button_to t(".confirm"), support_api_key_path(@api_key), method: :delete, warning: true %>
      <%= govuk_link_to t("cancel"), support_api_keys_path, no_visited_state: true %>
    </div>
  </div>
</div>
