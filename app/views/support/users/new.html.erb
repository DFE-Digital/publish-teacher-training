<%= render PageTitle.new(title: "support.users.new") %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_users_path,
  ) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    <%= form_with model: [:support_recruitment_cycle, @user], local: true do |f| %>
      <%= f.govuk_error_summary %>

      <h1 class="govuk-heading-l"><%= t(".heading") %></h1>

      <%= f.govuk_text_field :first_name, label: { text: t("support.users.checks.show.first_name"), size: "s" }, width: "two-thirds" %>
      <%= f.govuk_text_field :last_name, label: { text: t("support.users.checks.show.last_name"), size: "s" }, width: "two-thirds" %>
      <%= f.govuk_text_field :email, label: { text: t("support.users.checks.show.email"), size: "s" } %>

      <%= f.govuk_check_boxes_fieldset :admin, legend: { text: "Admin" }, multiple: false do %>
        <%= f.govuk_check_box :admin, true, false, label: { text: "This user is an admin" }, multiple: false, link_errors: true %>
      <% end %>

      <%= f.govuk_submit t(".continue") %>
    <% end %>

    <%= govuk_link_to(t("cancel"), support_recruitment_cycle_users_path) %>
  </div>
</div>
