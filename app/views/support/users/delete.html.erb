<%= render PageTitle.new(title: "support.users.delete") %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_user_path(params[:recruitment_cycle_year], @user),
  ) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= t(".heading", name: @user.full_name) %></h1>

    <p class="govuk-body"><%= t(".consequences_intro", name: @user.full_name) %></p>

    <ul class="govuk-list govuk-list--bullet">
      <li><%= t(".removed_from_providers") %></li>
      <li><%= t(".cannot_log_in") %></li>
      <li><%= t(".no_emails") %></li>
    </ul>

    <%= govuk_button_to(
          t(".submit", name: @user.full_name),
          support_recruitment_cycle_user_path(params[:recruitment_cycle_year], @user),
          method: :delete,
          class: "govuk-button--warning",
        ) %>
  </div>
</div>
