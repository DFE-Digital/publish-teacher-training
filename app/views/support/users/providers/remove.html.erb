<%= render PageTitle.new(title: "support.users.providers.remove") %>

<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
    text: "Back",
    href: support_recruitment_cycle_user_providers_path(params[:recruitment_cycle_year], @user),
  ) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l"><%= t(".heading", name: @user.full_name, provider: @provider.provider_name) %></h1>

    <div class="govuk-warning-text">
      <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
      <strong class="govuk-warning-text__text">
        <%= t(".warning", name: @user.full_name, provider: @provider.provider_name) %>
      </strong>
    </div>

    <%= govuk_button_to(
          t(".submit"),
          remove_provider_support_recruitment_cycle_user_path(params[:recruitment_cycle_year], @user, provider_id: @provider.id),
          method: :delete,
          class: "govuk-button--warning",
        ) %>

    <p class="govuk-body">
      <%= govuk_link_to(t("cancel"), support_recruitment_cycle_user_providers_path(params[:recruitment_cycle_year], @user)) %>
    </p>
  </div>
</div>
