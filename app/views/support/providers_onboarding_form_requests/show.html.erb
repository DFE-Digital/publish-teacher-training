<% content_for :page_title, "Provider details" %>
<% content_for :before_content do %>
  <%= govuk_back_link_to(support_providers_onboarding_form_requests_path) %>
<% end %>
<span class="govuk-caption-l"><%= t(".caption") %></span>
<h1 class="govuk-heading-l"><%= t(".provider_details", form_name: @onboarding_request.form_name) %></h1>
<!-- Onboarding Details -->
<%= govuk_summary_list do |summary_list| %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { t(".form_link") } %>
    <% row.with_value do %>
      <%= govuk_link_to(
            t(".view_provider_form"),
            publish_provider_onboarding_path(@onboarding_request.uuid),
          ) %>
    <% end %>
    <% row.with_action(text: "Copy link", classes: "copy-btn", href: "#", html_attributes: { hidden: true, data: { controller: "copy-link", action: "click->copy-link#copy", copy_link_target: "button", copy_link_text_value: publish_provider_onboarding_url(@onboarding_request.uuid) } }) %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { t(".zendesk_link") } %>
    <% row.with_value { @onboarding_request.zendesk_link.blank? ? t(".not_available") : govuk_link_to(t(".view_zendesk_ticket"), @onboarding_request.zendesk_link) } %>
  <% end %>
<% end %>
<!-- Organisation Details -->
<h2 class="govuk-heading-m govuk-!-margin-top-6"><%= t(".organisation_details") %></h2>
<% support_change_path = ->(anchor) { publish_provider_onboarding_path(@onboarding_request.uuid, return_to: Publish::ProviderOnboardingController::SUPPORT_RETURN_TO, anchor:) } %>
<%= govuk_summary_list do |summary_list| %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Provider name" } %>
    <% row.with_value { @onboarding_request.provider_name } %>
    <% row.with_action(text: "Change", href: support_change_path.call("providers-onboarding-form-request-provider-name-field"), visually_hidden_text: "provider name") %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "UK provider reference number (UKPRN)" } %>
    <% row.with_value { @onboarding_request.ukprn } %>
    <% row.with_action(text: "Change", href: support_change_path.call("providers-onboarding-form-request-ukprn-field"), visually_hidden_text: "UKPRN") %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Is the organisation an accredited provider?" } %>
    <% row.with_value { @onboarding_request.accredited_provider ? "Yes" : "No" } %>
    <% row.with_action(text: "Change", href: support_change_path.call("providers-onboarding-form-request-accredited-provider-field-error"), visually_hidden_text: "accredited provider") %>
  <% end %>
  <% if @onboarding_request.accredited_provider? %>
    <% accredited_provider_number_path = support_change_path.call("providers-onboarding-form-request-accredited-provider-number-field") %>
    <% summary_list.with_row do |row| %>
      <% row.with_key { "Accredited provider number" } %>
      <% if @onboarding_request.accredited_provider_number.present? %>
        <% row.with_value { @onboarding_request.accredited_provider_number } %>
        <% row.with_action(
             text: "Change",
             href: accredited_provider_number_path,
             visually_hidden_text: "accredited provider number",
           ) %>
      <% else %>
        <% row.with_value do %>
          <%= govuk_link_to("Enter accredited provider number", accredited_provider_number_path) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Provider type" } %>
    <% row.with_value { @onboarding_request.provider_type_label } %>
    <% row.with_action(
         text: "Change",
         href: support_change_path.call("providers-onboarding-form-request-provider-type-field"),
         visually_hidden_text: "provider type",
       ) %>
  <% end %>
  <% if @onboarding_request.lead_school? %>
    <% summary_list.with_row do |row| %>
      <% row.with_key { "Unique reference number (URN)" } %>
      <% row.with_value { @onboarding_request.urn } %>
      <% row.with_action(text: "Change", href: support_change_path.call("providers-onboarding-form-request-urn-field"), visually_hidden_text: "URN") %>
    <% end %>
  <% end %>
<% end %>
<!-- Contact Details -->
<h2 class="govuk-heading-m govuk-!-margin-top-6"><%= t(".contact_details") %></h2>
<%= govuk_summary_list(actions: false) do |summary_list| %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Contact email address" } %>
    <% row.with_value { @onboarding_request.contact_email_address } %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Telephone" } %>
    <% row.with_value { @onboarding_request.telephone } %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Website" } %>
    <% row.with_value { @onboarding_request.website } %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Address" } %>
    <% row.with_value(text: simple_format(@onboarding_request.full_address_on_separate_lines, {}, wrapper_tag: :div)) %>
  <% end %>
<% end %>
<!-- User Details -->
<h2 class="govuk-heading-m govuk-!-margin-top-6"><%= t(".user_details") %></h2>
<%= govuk_summary_list(actions: false) do |summary_list| %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Email address" } %>
    <% row.with_value { @onboarding_request.email_address } %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "First name" } %>
    <% row.with_value { @onboarding_request.first_name } %>
  <% end %>
  <% summary_list.with_row do |row| %>
    <% row.with_key { "Last name" } %>
    <% row.with_value { @onboarding_request.last_name } %>
  <% end %>
<% end %>
<% unless @onboarding_request.onboarded? || @onboarding_request.rejected? %>
  <p class="govuk-body">
    Click Onboard provider to approve the request, create an account for this provider on Publish, and generate a provider code. The person who submitted the onboarding form will be added as a user of the provider.
  </p>
  <div class="govuk-button-group" id="onboard-provider">
    <%= button_to "Onboard provider",
        support_providers_onboarding_form_request_path(@onboarding_request, status: "accept"),
        method: :patch,
        class: "govuk-button",
        form_class: "inline-form" %>
    <%= button_to "Reject provider",
        support_providers_onboarding_form_request_path(@onboarding_request, status: "reject"),
        method: :patch,
        class: "govuk-link app-link--destructive app-button-link",
        form_class: "inline-form" %>
  </div>
  <p class="govuk-body">
    <%= govuk_link_to(
              t(".cancel"),
              support_providers_onboarding_form_requests_path,
            ) %>
  </p>
<% end %>
</div>
