<%= content_for :page_title, title_with_error_prefix(t("find.cycles.title"), @form.errors.any?) %>

<% unless Rails.env.production? %>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <%= form_with model: @form, url: find_switch_cycle_schedule_path, method: :post do |f| %>
        <%= f.govuk_error_summary %>

        <h1 class="govuk-heading-l"><%= t("find.cycles.title") %></h1>

        <p class="govuk-body"><%= t("find.cycles.introduction") %></p>

        <%= f.govuk_radio_buttons_fieldset :cycle_schedule_name, legend: { text: t("find.cycles.legend"), size: "m" } do %>
          <% Find::CycleTimetable::SWITCHER_OPTIONS.each_key.with_index do |option, index| %>
            <% if option == :apply_open %>
              <h2 class="govuk-heading-s govuk-!-margin-bottom-2"><%= switcher_cycle_group_heading(option) %></h2>
            <% elsif option == :apply_not_open_yet %>
              <h2 class="govuk-heading-s govuk-!-margin-top-6 govuk-!-margin-bottom-2"><%= switcher_cycle_group_heading(option) %></h2>
            <% end %>

            <%= f.govuk_radio_button :cycle_schedule_name,
                  option.to_s,
                  label: -> { switcher_option_label(option) },
                  hint: { text: t("find.cycles.#{option}.description") },
                  link_errors: index.zero? do %>
              <% if option == :apply_open %>
                <%= f.govuk_check_box :deadline_banner, "1", "0",
                      multiple: false,
                      label: { text: t("find.cycles.deadline_banner.name") } %>
              <% end %>
            <% end %>
          <% end %>

          <%= f.govuk_radio_divider %>

          <%= f.govuk_radio_button :cycle_schedule_name,
                "real",
                label: { text: t("find.cycles.real.name") } %>
        <% end %>

        <%= f.govuk_submit t("find.cycles.submit") %>
      <% end %>
    </div>
  </div>
<% end %>
