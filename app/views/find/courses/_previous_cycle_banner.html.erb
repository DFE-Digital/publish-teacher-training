<% if @current_cycle_equivalent %>
  <%= govuk_warning_text do %>
    <%= t(
          "find.courses.show.previous_cycle.with_current_course_html",
          course_link: govuk_link_to(
            @current_cycle_equivalent.name_and_code,
            find_course_path(
              @current_cycle_equivalent.provider.provider_code,
              @current_cycle_equivalent.course_code,
            ),
          ),
        ) %>
  <% end %>
<% else %>
  <%= govuk_warning_text(text: t("find.courses.show.previous_cycle.without_current_course")) %>
<% end %>
