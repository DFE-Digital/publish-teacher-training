<% if preview?(params) %>
  <%# Preview only: the provider previewing the course is not a candidate, so show the
      prompt candidates will see without making it interactive. Branching on preview first
      also keeps the Find-only authenticated? helper out of the Publish render path. %>
  <%= render "find/courses/save_button_content", text: t(".sign_in_to_save_this_course") %>
<% elsif authenticated? %>
  <%= form_with url: find_candidate_saved_courses_path,
                method: :post do %>

    <%= hidden_field_tag :course_id, course.id %>

    <button type="submit" class="unstyled-button">
      <%= render "find/courses/save_button_content", text: t(".save_this_course") %>
    </button>
  <% end %>
<% else %>
  <%= link_to sign_in_find_candidate_saved_courses_path(course_id: course.id), class: "unstyled-button" do %>
    <%= render "find/courses/save_button_content", text: t(".sign_in_to_save_this_course") %>
  <% end %>
<% end %>
