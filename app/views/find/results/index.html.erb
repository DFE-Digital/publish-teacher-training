<%= content_for(
  :page_title,
  strip_tags(
    render(
      Find::Courses::ResultsPageTitle::View.new(courses_count: @courses_count, address: @address, subjects: @search_courses_form.subjects, radius: @search_courses_form.radius),
    ),
  ),
) %>
<%= render Courses::QueryDebugHeaderComponent.new(
  results: @results,
  applied_filters: @courses_query.applied_scopes,
  latitude: @search_params[:latitude],
  longitude: @search_params[:longitude],
  debug: params[:debug],
) %>
<% form = nil %>
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <%= render partial: "find/results/courses_guidance/show" %>
    <h1 class="govuk-heading-l">
      <%= render(Find::Courses::ResultsPageTitle::View.new(courses_count: @courses_count, address: @address, subjects: @search_courses_form.subjects, radius: @search_courses_form.radius)) %>
    </h1>
  </div>
</div>
<div class="govuk-grid-row">
  <div class="govuk-grid-column-one-third">
    <div class="app-search-location__controls">
      <%= form_with model: @search_courses_form, scope: "", id: "find-search-form", url: find_results_path, method: :get do |form_object| %>
        <% form = form_object %>
        <%= form.hidden_field :utm_source, value: "results" %>
        <%= form.hidden_field :previous_location_category, value: @search_courses_form.location_category %>
        <div class="app-find-search">
          <%= form.govuk_text_field :location,
              label: { text: t("helpers.label.courses_search_form.location"), size: "s" },
              form_group: {
                class: "suggestions",
                data: remote_autocomplete_data(path: find_geolocation_suggestions_path),
              },
              autocomplete: "off", value: @address.short_address %>
          <%= form.govuk_submit t("helpers.submit.courses_search_form.search"), name: "utm_medium", value: "search" %>
        </div>
      <% end %>
    </div>
    <div class="app-filter">
      <h2 class="app-filter__heading govuk-heading-m"><%= t(".filter_results") %></h2>
      <%= render "find/results/filters/all", form_id: "find-search-form", form: %>
    </div>
  </div>
  <div class="govuk-grid-column-two-thirds">
    <% if show_salary_subject_message?(params) %>
      <div class="govuk-inset-text app-card app-card--inset--salaried">
        <h3 class="govuk-heading-s">
          Is a salaried course right for me?
        </h3>
        <p class="govuk-body">
          Fee paying courses are less competitive, and you could receive more money if you're eligible for <a href="https://getintoteaching.education.gov.uk/funding-and-support/scholarships-and-bursaries" class="govuk-link govuk-link--no-visited-state">bursaries or scholarships</a>.
        </p>
      </div>
    <% end %>
    <% if @results.present? %>
      <ul class="app-search-results">
        <% @results.each do |course| %>
          <%= render Courses::SummaryCardComponent.new(
              candidate: @candidate,
              course:,
              location: @search_params[:formatted_address] || @search_params[:location],
              short_address: @address.short_address,
              show_start_date: @show_start_date,
              visa_sponsorship: @search_params[:can_sponsor_visa],
              locality: @search_courses_form.locality,
              administrative_area_level_2: @search_courses_form.administrative_area_level_2,
              postal_code: @search_courses_form.postal_code,
            ) %>
          <%= render Courses::SchoolDistancesDebugComponent.new(
              course:,
              latitude: @search_params[:latitude],
              longitude: @search_params[:longitude],
              debug: params[:debug],
            ) %>
        <% end %>
      </ul>
      <%= govuk_pagination(pagy: @pagy) %>
    <% else %>
      <%= render Courses::NoResultsComponent.new(search_params: @search_params) %>
    <% end %>
  </div>
</div>
</div>
