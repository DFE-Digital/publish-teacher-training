<% heading = school_label_for(current_step) %>
<% content_for :page_title, title_with_error_prefix(heading, current_step.errors.any?) %>

<h1 class="govuk-heading-l">
  <%= render CaptionText.new(text: t("course_wizard.steps.schools.caption")) %>
  <%= heading %>
</h1>

<p class="govuk-body">
  <%= t("course_wizard.steps.schools.description") %>
</p>

<p class="govuk-body">
  <%= t("course_wizard.steps.schools.percentage") %>
</p>

<div class="govuk-warning-text">
  <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
  <strong class="govuk-warning-text__text">
    <%= school_warning_text(current_step) %>
  </strong>
</div>

<p class="govuk-hint">
  <%= t("course_wizard.steps.schools.hint") %>
</p>

<%# The summary says what the ticks add up to; it takes in the whole list, so it
    wraps the search and the collapse rather than sitting inside either of them.
    The baseline is what the wizard has stored, which is empty on the way in and
    the schools already chosen on the way back. %>
<%= render ::Publish::Schools::ChangesSummaryComponent.new(attached: current_step.attached_school_uuids) do %>
  <%# The panel says which schools a search allows; the list decides how many of
      those the collapse threshold lets on screen. %>
  <div data-controller="schools-list"
       data-schools-list-collapse-after-value="<%= current_step.schools_collapse_threshold %>"
       data-action="keydown->schools-list#keydown">
    <%= render ::Publish::Schools::SearchPanelComponent.new(schools: current_step.schools, value: :uuid) %>

    <%= form.govuk_check_boxes_fieldset :school_uuids,
          legend: { hidden: true, text: heading } do %>
      <%= render "publish/schools/checkbox_list",
            form:,
            schools: current_step.schools,
            select_all: false,
            include_hidden: false %>

      <% if current_step.collapse_schools? %>
        <button type="button"
                class="app-button-link govuk-!-font-size-19 govuk-!-margin-top-4"
                hidden
                data-schools-list-target="showAll"
                data-action="schools-list#showAll">
          <%= t("publish.courses.schools.show_all") %>
        </button>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= form.govuk_submit t("course_wizard.steps.schools.submit") %>
