<%# Labels used in both the option text and selected course details panel %>
<% age_label =
     if other_course.primary_course?
       I18n.t(
         "publish.courses.course_table.primary_age_range",
         age_range: other_course.age_range,
       )
     end %>
<% funding_label = I18n.t("publish.courses.course_table.funding.#{other_course.funding}") %>
<% qualification_label = other_course.qualifications_summary %>
<% study_mode_label = other_course.study_mode_description.capitalize %>
<% start_date_label =
     if other_course.start_date.present?
       I18n.l(
         other_course.start_date.to_date,
         format: :short,
       )
     end %>
<%# Option attributes used by the Stimulus controller %>
<option
  value="<%= other_course.course_code %>"
  data-name="<%= other_course.name %>"
  data-code="<%= other_course.course_code %>"
  data-age="<%= age_label %>"
  data-funding="<%= funding_label %>"
  data-qualification="<%= qualification_label %>"
  data-study-mode="<%= study_mode_label %>"
  data-start-date="<%= start_date_label %>">
  <%# Text displayed in the dropdown %>
  <%# Course name/code and primary age range are always shown in the drop down list. Other course information is only shown when it differs across the courses available for copying %>
  <%= [
    other_course.name_and_code,
    age_label,
    (funding_label if visible_course_information_fields.include?(:funding)),
    (qualification_label if visible_course_information_fields.include?(:qualification)),
    (study_mode_label if visible_course_information_fields.include?(:study_mode)),
    (start_date_label if visible_course_information_fields.include?(:start_date)),
  ].compact.reject(&:blank?).join(", ") %>
</option>
