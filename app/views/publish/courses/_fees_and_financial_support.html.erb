<% enrichment_summary(
  summary_list,
  :course,
  t("publish.providers.courses.description_content.fee_for_uk_citizens_label"),
  number_to_currency(course.fee_uk_eu),
  %w[fee_uk_eu],
  action_path: course.is_withdrawn? ? nil : fields_fees_and_financial_support_publish_provider_recruitment_cycle_course_path(@provider.provider_code, course.recruitment_cycle_year, course.course_code),
  action_visually_hidden_text: t("publish.providers.courses.description_content.fee_for_uk_citizens_label"),
  prompt: t("publish.providers.courses.description_content.enter_fee_for_uk_citizens"),
) %>

<% international_fee_label, international_fee_prompt =
     if course.can_sponsor_student_visa?
       [t("publish.providers.courses.description_content.fee_international_label"),
        t("publish.providers.courses.description_content.enter_fee_international")]
     else
       [t("publish.providers.courses.description_content.fee_international_optional_label"),
        t("publish.providers.courses.description_content.enter_fee_international_optional")]
     end %>

<% enrichment_summary(
  summary_list,
  :course,
  international_fee_label,
  number_to_currency(course.fee_international),
  %w[fee_international],
  action_path: course.is_withdrawn? ? nil : fields_fees_and_financial_support_publish_provider_recruitment_cycle_course_path(@provider.provider_code, course.recruitment_cycle_year, course.course_code),
  action_visually_hidden_text: t("publish.providers.courses.description_content.fee_for_international_citizens_label"),
  prompt: international_fee_prompt,
) %>

<% enrichment_summary(
  summary_list,
  :course,
  t("publish.providers.courses.description_content.fee_details_label"),
  markdown(course.fee_schedule) + markdown(course.additional_fees) + markdown(course.financial_support),
  %w[financial_support],
  action_path: course.is_withdrawn? ? nil : fields_fees_and_financial_support_publish_provider_recruitment_cycle_course_path(@provider.provider_code, course.recruitment_cycle_year, course.course_code),
  action_visually_hidden_text: t("publish.providers.courses.description_content.fee_details_hidden_text"),
  prompt: t("publish.providers.courses.description_content.enter_fee_details"),
) %>
