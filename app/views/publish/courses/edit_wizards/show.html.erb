<% content_for :before_content do %>
  <%= govuk_back_link_to(@wizard.previous_step_path(fallback: @wizard.caller_url)) %>
<% end %>

<div class="govuk-grid-row">
  <%= form_with(
        model: current_step,
        scope: current_step_name,
        url: @wizard.resolve_step_path(current_step_name),
        method: :patch,
      ) do |form| %>
    <div class="govuk-grid-column-full">
      <%= form.govuk_error_summary %>
    </div>

    <div class="govuk-grid-column-two-thirds">
      <% if current_step_name == :confirm_changes %>
        <%= render "confirm_changes", form: %>
      <% else %>
        <%= render "publish/course_wizards/steps/#{current_step_name}", form:, caption: @wizard.record.name_and_code %>
      <% end %>
      <p class="govuk-body">
        <%= govuk_link_to(t("course_wizard.show.cancel"), @wizard.caller_url) %>
      </p>
    </div>
  <% end %>
</div>
