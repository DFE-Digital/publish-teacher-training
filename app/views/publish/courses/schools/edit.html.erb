<% page_title = school_label_for(course) %>
<% content_for :page_title, title_with_error_prefix("#{page_title} – #{course.name_and_code}", @course_school_form.errors.present?) %>

<% content_for :before_content do %>
  <%= govuk_back_link_to(details_publish_provider_recruitment_cycle_course_path(@provider.provider_code, course.recruitment_cycle_year, course.course_code)) %>
<% end %>

<%= form_with(
  model: @course_school_form,
  url: schools_publish_provider_recruitment_cycle_course_path(@provider.provider_code, course.recruitment_cycle_year, course.course_code),
  method: :put,
  local: true,
) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <%= render ::Publish::Schools::NotificationBannerComponent.new(
        recruitment_cycle: @recruitment_cycle,
        provider: @provider,
      ) %>

      <h1 class="govuk-heading-l">
        <%= render CaptionText.new(text: course.name_and_code) %>
        <%= page_title %>
      </h1>

      <p class="govuk-body">
        <%= t("publish.courses.schools.attached_count", count: course.attached_schools_count) %>
      </p>

      <%# The summary says what the ticks add up to; it takes in the whole list, so
          it wraps the search and the collapse rather than sitting inside either of
          them. %>
      <%= render ::Publish::Schools::ChangesSummaryComponent.new(attached: @course_school_form.attached_school_uuids) do %>
        <%# The panel says which schools a search allows; the list decides how many
            of those the collapse threshold lets on screen. %>
        <div data-controller="schools-list"
             data-schools-list-collapse-after-value="<%= @course_school_form.schools_collapse_threshold %>"
             data-action="keydown->schools-list#keydown">
          <%= render ::Publish::Schools::SearchPanelComponent.new(schools: @course_school_form.schools, value: :uuid) %>

          <%= f.govuk_check_boxes_fieldset :school_uuids,
              legend: { text: page_title, hidden: true },
              form_group: { data: { controller: "select-all-checkboxes" } } do %>

              <div class="govuk-checkboxes__item" data-schools-list-target="bulkSelect">
                <input type="checkbox"
                       class="govuk-checkboxes__input"
                       id="select-all-schools"
                       data-select-all-checkboxes-target="selectAll"
                       <%# Setting the boxes fires nothing on them, so the summary
                           hears it from here. Listening for the event rather than
                           being listed after it means the order of these two
                           cannot matter. %>
                       data-action="select-all-checkboxes#toggleAll
                                    select-all-checkboxes:toggled->schools-changes#update">

                <label class="govuk-label govuk-checkboxes__label" for="select-all-schools">
                  <%= t("publish.courses.schools.select_all") %>
                </label>
              </div>

              <div class="govuk-body govuk-!-margin-left-2" data-schools-list-target="bulkSelect">or</div>
              <div class="govuk-hint"><%= t("publish.courses.schools.new.selection") %></div>

              <%= render "publish/schools/checkbox_list",
                    form: f,
                    schools: @course_school_form.schools,
                    select_all: true,
                    include_hidden: true %>

              <% if @course_school_form.collapse_schools? %>
                <button type="button"
                        class="app-button-link govuk-!-font-size-19 govuk-!-margin-top-4"
                        hidden
                        data-schools-list-target="showAll"
                        data-action="schools-list#showAll">
                  <%= t("publish.courses.schools.show_all") %>
                </button>
              <% end %>
          <% end %>
        </div>
      <% end %>

      <%= f.govuk_submit t("publish.courses.schools.continue_to_bulk_update") %>
    <% end %>

    <p class="govuk-body">
      <%= govuk_link_to(t("cancel"), details_publish_provider_recruitment_cycle_course_path(@provider.provider_code, @provider.recruitment_cycle.year, @course.course_code)) %>
    </p>
  </div>
</div>
