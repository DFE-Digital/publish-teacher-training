<%= render PageTitle.new(title: "publish.providers.schools.delete") %>
<% content_for :before_content do %>
  <%= govuk_back_link_to(school_show_path(provider_school.id)) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      <span class="govuk-caption-l"><%= provider_school.location_name %></span>
      <% if provider_school.has_no_course? %>
        <%= t("components.page_titles.publish.providers.schools.delete") %>
        </h1>
        <%= govuk_button_to "Remove school",
          school_delete_path(provider_school.id),
          method: :delete,
          class: "govuk-button--warning" %>
      <% else %>
        <%= t("components.page_titles.publish.providers.schools.no_delete") %>
      </h1>
      <p class="govuk-body">
        <%= "#{provider_school.location_name} is a school for courses run by #{@provider.provider_name}." %>
      </p>
      <p class="govuk-body">
        To remove <%= provider_school.location_name.to_s %>, you must first remove the school from those courses.
      </p>
    <% end %>
    <p class="govuk-body">
      <%= govuk_link_to("Cancel", school_show_path(provider_school.id)) %>
    </p>
  </div>
</div>
