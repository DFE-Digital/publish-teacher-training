<% heading = if returning_to_support?
               t("publish.users.delete.heading_from_support", name: @provider_user.full_name, provider: @provider.provider_name)
             else
               t("page_titles.users.delete")
             end %>
<%= content_for :page_title, heading %>

<% content_for :before_content do %>
  <%= govuk_back_link_to(user_delete_return_path) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      <% unless returning_to_support? %>
        <span class="govuk-caption-l"><%= @provider_user.full_name %></span>
      <% end %>
      <%= heading %>
    </h1>

    <div class="govuk-warning-text">
      <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
      <strong class="govuk-warning-text__text">
        <% if returning_to_support? %>
          <%= t("publish.users.delete.warning_from_support", provider: @provider.provider_name) %>
        <% else %>
          <%= t("publish.users.delete.warning") %>
        <% end %>
      </strong>
    </div>

    <%= govuk_button_to "Remove user",
                        user_delete_path_with_return,
        method: :delete,
        class: "govuk-button--warning" %>

    <p class="govuk-body">
      <%= govuk_link_to(t("cancel"), user_delete_return_path) %>
    </p>
  </div>
</div>
