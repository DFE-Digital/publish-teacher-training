<% name = @provider_user.full_name %>
<% provider_name = @provider.provider_name %>
<% if removing_yourself? %>
  <% title = t(".title_yourself", provider_name:) %>
  <% warning = t(".warning_yourself", provider_name:) %>
<% else %>
  <% title = t(".title_other", name:, provider_name:) %>
  <% warning = t(".warning_other", name:, provider_name:) %>
<% end %>
<%= content_for :page_title, title %>

<% content_for :before_content do %>
  <%= govuk_back_link_to(publish_provider_user_path(id: params[:id])) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      <span class="govuk-caption-l"><%= name %></span>
        <%= title %>
    </h1>

    <div class="govuk-warning-text">
      <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
      <strong class="govuk-warning-text__text">
        <%= warning %>
      </strong>
    </div>

    <%= govuk_button_to t(".remove_user"),
                        delete_publish_provider_user_path,
        method: :delete,
        class: "govuk-button--warning" %>

    <p class="govuk-body">
      <%= govuk_link_to(t("cancel"), publish_provider_user_path(id: params[:id])) %>
    </p>
  </div>
</div>
