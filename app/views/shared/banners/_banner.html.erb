<%# locals: (banner:) %>

<%= govuk_notification_banner(
      title_text: banner.title,
      title_heading_level: banner.title_heading_level || 1,
      success: banner.success_styling,
    ) do |notification_banner| %>
  <% notification_banner.with_heading(text: banner.heading) %>

  <%= markdown banner.body %>
<% end %>
